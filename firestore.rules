rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can read and write only their own data, and only while
    // signed in.
    //
    // The {document=**} wildcard is required: a `match /users/{userId}` rule
    // covers that document alone and NOT its subcollections. Log sharding
    // stores months at users/{uid}/logs/{YYYY-MM}, which would be denied
    // without this.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }
  }
}
